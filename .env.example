# Copy this file to ".env" and fill in real values before running
# `docker compose up -d --build`. Never commit the real .env file.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
APP_NAME=WebDesktop
ENVIRONMENT=production
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_TTL_MINUTES=720
MFA_PENDING_TTL_MINUTES=5

# Public port the frontend container listens on. Point your external
# TLS-terminating Nginx reverse proxy at this port.
FRONTEND_PORT=8080

# ---------------------------------------------------------------------------
# Database (internal network only, never exposed to the host)
# ---------------------------------------------------------------------------
POSTGRES_USER=webdesktop
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=webdesktop

# ---------------------------------------------------------------------------
# Reverse proxy trust
# ---------------------------------------------------------------------------
# Number of trusted reverse-proxy hops in front of the backend:
# 2 = external TLS-terminating Nginx + the frontend container's internal Nginx.
TRUSTED_PROXY_HOPS=2

# ---------------------------------------------------------------------------
# Admin / security dashboard IP allow-list
# ---------------------------------------------------------------------------
# RFC1918 private ranges + loopback are always allowed. Add extra CIDRs here
# (comma separated) for VPN ranges etc, e.g. "100.64.0.0/10,203.0.113.4/32".
ADMIN_IP_WHITELIST=

# ---------------------------------------------------------------------------
# Internal service hostnames the browser proxy (text + full mode) is allowed
# to reach even though they resolve to a private Docker IP - never add a
# hostname here that isn't a first-party service you deployed yourself.
# ---------------------------------------------------------------------------
INTERNAL_PROXY_ALLOWLIST=roundcube

# ---------------------------------------------------------------------------
# Rate limiting / progressive lockout
# ---------------------------------------------------------------------------
LOGIN_MAX_ATTEMPTS_PER_WINDOW=5
LOGIN_WINDOW_SECONDS=300
LOCKOUT_BASE_SECONDS=30
LOCKOUT_MAX_SECONDS=3600
MFA_ALERT_FAILURE_THRESHOLD=3

# ---------------------------------------------------------------------------
# SMTP alerting (leave SMTP_HOST empty to disable email alerts)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=alerts@webdesktop.local
SMTP_ALERT_TO=security-team@example.com

# ---------------------------------------------------------------------------
# Text-mode browser proxy
# ---------------------------------------------------------------------------
BROWSER_PROXY_TIMEOUT_SECONDS=12
BROWSER_PROXY_MAX_BYTES=3145728
# Safety cap on a single streamed asset (images/video/audio/fonts).
BROWSER_PROXY_MAX_STREAM_BYTES=1073741824

# ---------------------------------------------------------------------------
# Full-browser mode: a real headless Chromium tab, opt-in per browser tab
# for sites that need JavaScript to render at all (the text-mode proxy never
# executes any). Much heavier on bandwidth/CPU than text mode - see the
# README for the trade-off. Set FULL_BROWSER_ENABLED=false to disable it
# entirely (also skips launching Chromium at startup).
# ---------------------------------------------------------------------------
FULL_BROWSER_ENABLED=true
FULL_BROWSER_MAX_SESSIONS=3
FULL_BROWSER_IDLE_TIMEOUT_SECONDS=300
FULL_BROWSER_MAX_LIFETIME_SECONDS=3600
FULL_BROWSER_FRAME_INTERVAL_MS=350
# Frame rate once nothing has happened for ACTIVE_WINDOW_SECONDS - much
# slower on purpose, this is what keeps an idle full-mode tab from quietly
# eating CPU/bandwidth in the background.
FULL_BROWSER_IDLE_FRAME_INTERVAL_MS=2000
FULL_BROWSER_ACTIVE_WINDOW_SECONDS=2.0

# ---------------------------------------------------------------------------
# First-run admin bootstrap
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Leave empty to auto-generate a random password (printed once in the
# backend container logs on first start, along with the TOTP secret).
BOOTSTRAP_ADMIN_PASSWORD=
# Lost the admin password? Set this to true, run
# `docker compose up -d --build backend`, then read the new password from
# `docker compose logs backend`. Set it back to false afterwards, otherwise
# the password (and TOTP secret) resets on every restart.
RESET_ADMIN_PASSWORD=false

# ---------------------------------------------------------------------------
# File explorer: SMB share (leave SMB_HOST empty to disable the SMB tab)
# ---------------------------------------------------------------------------
# Hostname or IP of your home NAS / SMB server.
SMB_HOST=
SMB_PORT=445
# Name of the share to mount, e.g. "home" for \\nas\home.
SMB_SHARE=
SMB_USERNAME=
SMB_PASSWORD=

# ---------------------------------------------------------------------------
# Self-update from the webdesktop (Paramètres > Système). Opt-in - see the
# big warning in docker-compose.selfupdate.yml before enabling. Leave
# SELF_UPDATE_ENABLED=false (the default) to never grant the backend any
# access to Docker or the host filesystem.
# ---------------------------------------------------------------------------
SELF_UPDATE_ENABLED=false
UPDATE_GITHUB_REPO=
UPDATE_GIT_BRANCH=main
# Must be the ABSOLUTE path of this project directory on the HOST machine
# (not a path inside a container), e.g. /home/user/musical-succotash.
HOST_PROJECT_DIR=
# Only needed for domain accounts (leave empty for a local NAS account).
SMB_DOMAIN=

# ---------------------------------------------------------------------------
# Roundcube webmail (bundled, internal-only - see docker-compose.yml).
# OPTIONAL and disabled by default: a plain `docker compose up -d --build`
# never starts it. To enable it:
#   docker compose --profile roundcube up -d --build
# Roundcube itself now reads from the bundled Dovecot server (a unified
# inbox), which "fetchmail" keeps filled from whatever external IMAP
# accounts each user adds in Paramètres → Applications - no IMAP host to
# configure here. ROUNDCUBE_SMTP_HOST is only used for SENDING mail from
# Roundcube (Dovecot has no SMTP of its own) - point it at any provider
# that will relay for you, or leave empty and configure per-identity SMTP
# inside Roundcube itself for each address you send from.
# ---------------------------------------------------------------------------
ROUNDCUBE_SMTP_HOST=
ROUNDCUBE_SMTP_PORT=587
# Exactly 24 characters, used to encrypt the stored IMAP password. Generate
# with: openssl rand -hex 12
ROUNDCUBE_DES_KEY=
