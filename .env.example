# Copy this file to ".env" and fill in real values before running
# `docker compose up -d --build`. Never commit the real .env file.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
APP_NAME=WebDesktop
ENVIRONMENT=production
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_TTL_MINUTES=720
MFA_PENDING_TTL_MINUTES=5

# Public port the frontend container listens on. Point your external
# TLS-terminating Nginx reverse proxy at this port.
FRONTEND_PORT=8080

# ---------------------------------------------------------------------------
# Database (internal network only, never exposed to the host)
# ---------------------------------------------------------------------------
POSTGRES_USER=webdesktop
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=webdesktop

# ---------------------------------------------------------------------------
# Reverse proxy trust
# ---------------------------------------------------------------------------
# Number of trusted reverse-proxy hops in front of the backend:
# 2 = external TLS-terminating Nginx + the frontend container's internal Nginx.
TRUSTED_PROXY_HOPS=2

# ---------------------------------------------------------------------------
# Admin / security dashboard IP allow-list
# ---------------------------------------------------------------------------
# RFC1918 private ranges + loopback are always allowed. Add extra CIDRs here
# (comma separated) for VPN ranges etc, e.g. "100.64.0.0/10,203.0.113.4/32".
ADMIN_IP_WHITELIST=

# ---------------------------------------------------------------------------
# Rate limiting / progressive lockout
# ---------------------------------------------------------------------------
LOGIN_MAX_ATTEMPTS_PER_WINDOW=5
LOGIN_WINDOW_SECONDS=300
LOCKOUT_BASE_SECONDS=30
LOCKOUT_MAX_SECONDS=3600
MFA_ALERT_FAILURE_THRESHOLD=3

# ---------------------------------------------------------------------------
# SMTP alerting (leave SMTP_HOST empty to disable email alerts)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=alerts@webdesktop.local
SMTP_ALERT_TO=security-team@example.com

# ---------------------------------------------------------------------------
# Text-mode browser proxy
# ---------------------------------------------------------------------------
BROWSER_PROXY_TIMEOUT_SECONDS=12
BROWSER_PROXY_MAX_BYTES=3145728

# ---------------------------------------------------------------------------
# First-run admin bootstrap
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Leave empty to auto-generate a random password (printed once in the
# backend container logs on first start, along with the TOTP secret).
BOOTSTRAP_ADMIN_PASSWORD=
